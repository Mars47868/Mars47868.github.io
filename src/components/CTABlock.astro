---
interface Props {
  heading: string;
  desc?: string;
  email: string;
  linkedin?: string;
  github?: string;
  resume?: string;
}
const { heading, desc, email, linkedin, github, resume } = Astro.props;
---
<section class="cta-section" id="contact">
  <div class="cta-block">
    <h2 class="cta-headline" set:html={heading} />
    {desc && <p class="cta-desc">{desc}</p>}
    <div class="cta-links">
      <a class="cta-btn cta-btn-primary" href={`mailto:${email}`}>
        寫信給我
      </a>
      {resume && (
        <a class="cta-btn cta-btn-secondary" href={resume} target="_blank" rel="noopener noreferrer">
          履歷 PDF ↓
        </a>
      )}
      {linkedin && (
        <a class="cta-btn cta-btn-secondary" href={linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn →
        </a>
      )}
      {github && (
        <a class="cta-btn cta-btn-secondary" href={github} target="_blank" rel="noopener noreferrer">
          GitHub →
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section { padding: 3rem 0; }
  .cta-block {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-card);
  }
  .cta-headline {
    font-family: var(--font-head);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
    line-height: 1.45;
  }
  .cta-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
  }
  .cta-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition);
    cursor: pointer;
  }
  .cta-btn-primary {
    background: var(--color-teal);
    color: var(--color-on-accent);
    border: 1px solid var(--color-teal);
  }
  .cta-btn-primary:hover { background: var(--color-teal-mid); border-color: var(--color-teal-mid); }
  .cta-btn-secondary {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-mid);
  }
  .cta-btn-secondary:hover {
    border-color: var(--color-teal);
    color: var(--color-teal);
  }
  @media (max-width: 600px) {
    .cta-links { flex-direction: column; }
    .cta-btn { justify-content: center; }
  }
</style>
